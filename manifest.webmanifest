{
  "name": "awebp — tus fotos, en WebP",
  "short_name": "awebp",
  "description": "Convierte tus fotos a WebP en un toque, sin subirlas a ningún lado.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0e13",
  "theme_color": "#0a0e13",
  "icons": [
    {
      "src": "./icons/icono-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icono-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "enlace",
      "files": [
        {
          "name": "fotos",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
